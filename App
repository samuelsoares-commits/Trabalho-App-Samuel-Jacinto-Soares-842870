<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reserva de Carros</title>
  <style>
    /* Reset e estilos básicos */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background-color: #f4f6f9;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    /* Container Principal do App */
    .app-card {
      background: white;
      width: 100%;
      max-width: 380px;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    /* Título e Cabeçalho */
    h1 {
      font-size: 1.4rem;
      color: #1f2937;
      margin-bottom: 8px;
      text-align: center;
    }

    p.subtitle {
      font-size: 0.9rem;
      color: #6b7280;
      text-align: center;
      margin-bottom: 20px;
    }

    /* Alternância de Telas (Esconder / Mostrar) */
    .tela {
      display: none;
    }

    .tela.ativa {
      display: block;
    }

    /* Formulário da Tela 1 */
    .form-group {
      margin-bottom: 15px;
    }

    label {
      display: block;
      font-size: 0.85rem;
      font-weight: bold;
      color: #374151;
      margin-bottom: 5px;
    }

    select, input {
      width: 100%;
      padding: 10px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 0.95rem;
      outline: none;
    }

    /* Botões */
    button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-principal {
      background-color: #2563eb;
      color: white;
      margin-top: 10px;
    }

    .btn-principal:hover {
      background-color: #1d4ed8;
    }

    .btn-voltar {
      background-color: #e5e7eb;
      color: #374151;
      margin-top: 15px;
    }

    .btn-voltar:hover {
      background-color: #d1d5db;
    }

    /* Tela 2: Confirmação */
    .recibo {
      background-color: #f9fafb;
      border: 1px dashed #d1d5db;
      border-radius: 8px;
      padding: 15px;
      margin: 15px 0;
    }

    .item-recibo {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 0.9rem;
    }

    .item-recibo strong {
      color: #111827;
    }

    .status-badge {
      background-color: #d1fae5;
      color: #065f46;
      text-align: center;
      padding: 6px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: bold;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>

  <div class="app-card">

